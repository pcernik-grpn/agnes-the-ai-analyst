# Agnes AI Harness - Environment Variables
# =============================================
# Copy to .env: cp config/.env.template .env
# .env is gitignored - NEVER commit it.

# ── REQUIRED ────────────────────────────────────────
JWT_SECRET_KEY=              # python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=              # python -c "import secrets; print(secrets.token_hex(32))"

# Vault key for every secret Agnes stores in the DB (Fernet, encrypted at rest).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required to store DATA-SOURCE credentials and MCP source secrets (outside
# LOCAL_DEV_MODE). Without it NO data source can be connected at all — the
# "+ Add source" button on /admin/data-sources is disabled — so this is not
# optional for an instance that reads any data. It said "MCP source secrets"
# for a while, which read as skippable to anyone not using MCP. Set it before
# first boot and RESTART the server after changing it. Keep it stable —
# rotating it makes previously-stored secrets undecryptable.
AGNES_VAULT_KEY=

# App-state Postgres (A1: default for new installs — see docs/QUICKSTART.md).
# Used by both the `postgres` and `app` services in docker-compose.postgres.yml,
# which `COMPOSE_FILE` below wires in. `docker compose up` refuses to start
# `postgres` without it set.
POSTGRES_PASSWORD=            # python -c "import secrets; print(secrets.token_hex(16))"

# Canonical local-dev compose chain: base graph + the Postgres side-car
# overlay. Comment this out (and set DATABASE_URL to a managed Postgres, or
# unset both for legacy single-file DuckDB — see below) only for an existing
# instance that predates the Postgres default.
COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml

# ── POSTGRES (legacy DuckDB fallback / self-hosted managed PG) ──────────
# Existing single-VM DuckDB-only instances: unset POSTGRES_PASSWORD and
# COMPOSE_FILE above, and app state stays on DuckDB. Analytics is always
# DuckDB either way (users, RBAC, registry, audit, knowledge, marketplace,
# store, etc. is what moves to Postgres).
#
# Self-hosted prod (managed PG — Cloud SQL, RDS, Azure DB) instead of the
# bundled side-car container:
#     DATABASE_URL=postgresql+psycopg://agnes:<pw>@<host>:5432/agnes
#
# Cloud SQL private IP via Unix socket:
#     DATABASE_URL=postgresql+psycopg://agnes:<pw>@/agnes?host=/cloudsql/<proj>:<region>:<inst>
#
# `+psycopg` selects the psycopg 3 dialect — required. See docs/migrations.md.
# DATABASE_URL=postgresql+psycopg://agnes:agnes@localhost:5432/agnes
# # Legacy alias accepted for backward compatibility (emits deprecation warning):
# # AGNES_DB_URL=postgresql+psycopg://agnes:agnes@localhost:5432/agnes

# ── GOOGLE OAUTH (required for Google login) ────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── MICROSOFT ENTRA ID OAUTH (required for Microsoft login) ──
# Single-tenant sign-in. Register an app in Entra ID, set the redirect URI
# to <SERVER_URL>/auth/microsoft/callback, and paste the tenant + client here.
# TENANT_ID must be the directory (tenant) ID GUID or a verified domain — the
# multi-tenant endpoints (common / organizations / consumers) are refused and
# leave the provider unavailable with a boot error.
# NOTE: one tenant is the AUTHENTICATION boundary, not the identity boundary —
# B2B guests invited into the tenant sign in too, carrying their external
# address, and Agnes matches accounts by address alone. Set auth.allowed_domain
# in instance.yaml to the domains you own. See docs/auth-microsoft-oauth.md.
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ── KEBOOLA (required for Keboola data source) ──────
# KEBOOLA_STORAGE_TOKEN=
# KEBOOLA_STACK_URL=https://connection.keboola.com

# ── BIGQUERY (required for BigQuery data source) ─────
# BIGQUERY_PROJECT=
# BIGQUERY_LOCATION=us

# ── DATABRICKS (required for the Databricks data source) ─────
# Workspace PAT or OAuth M2M access token for the SQL warehouse
# (materialized rows + Unity Catalog metric-view sync). Host/warehouse/catalog
# live in instance.yaml under data_source.databricks.*.
# DATABRICKS_TOKEN=
# DATABRICKS_HOST=https://dbc-a1b2c3d4-e5f6.cloud.databricks.com
# DATABRICKS_WAREHOUSE_ID=

# ── SNOWFLAKE (required for the Snowflake data source) ─────
# Snowflake user password (auth_type=password, the default). Account, database,
# warehouse, and optional role live in instance.yaml under data_source.snowflake.*.
# SNOWFLAKE_PASSWORD=
#
# For key-pair auth (auth_type=key_pair), set the private key PEM and optional
# passphrase. The key may be stored as a JSON envelope {"private_key":"...PEM...","passphrase":"..."}
# so a single env/vault secret carries both, or as a plain PEM with the passphrase in the
# separate env var below.
# SNOWFLAKE_PRIVATE_KEY=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ── BOOTSTRAP (first deploy only) ───────────────────
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=                # Dev helper only — sets password_hash on seed.
#                                     # Never overwrites an existing password.

# ── EMAIL / SMTP (required for magic link auth) ─────
# The only mail transport. SendGrid & co. work via their SMTP relay
# (e.g. SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com       # sender for magic-link/reset/invite mail

