# Agnes AI Harness - Instance Configuration
# ==========================================
# This is the main configuration file for your instance.
# Copy to instance.yaml and fill in your values.
#
# SECRET VALUES use ${ENV_VAR} syntax - actual values go in .env file.
# Non-secret values are set directly here.

# --- Config version ---
# Incremented when the config schema changes. Must match SUPPORTED_CONFIG_VERSIONS
# in config/loader.py. Currently only version 1 is supported.
config_version: 1

# --- Instance branding ---
instance:
  name: "AI Harness"
  subtitle: "Your Organization"
  copyright: "Your Organization"   # Footer credit, rendered "Deployed by <this>".
                                     # Leave unset and the footer shows only the
                                     # product name + running build — it never
                                     # invents an attribution.
  # privacy_policy_url: "https://example.com/legal/privacy"
                                     # Your organization's own privacy policy. When set, /privacy
                                     # redirects there instead of rendering the built-in page.
                                     # Agnes is self-hosted, so YOU are the data controller — the
                                     # built-in page can only describe what the software does.
                                     # Give <instance>/privacy as the privacy URL when registering
                                     # a connector; it answers correctly either way.
                                     # Env override: AGNES_PRIVACY_POLICY_URL.
  # brand: "Agnes"                   # Product-name brand string used in analyst-facing UI copy
                                     # (/home hero, /setup, /login messages, clipboard setup
                                     # script). Default "Agnes". Set to e.g. "Foundry AI" to
                                     # rebrand without forking. Distinct from `name` above:
                                     # `name` is the deploying organization, `brand` is the
                                     # product. Env override: AGNES_INSTANCE_BRAND.
  # brand_short: "Agnes"             # Short form of `brand` used mid-sentence in /home body
                                     # copy (e.g. brand "Acme Data Analyst" -> short "Acme").
                                     # When it differs from `brand`, the /home hero appends
                                     # "Call me <brand_short>." after the title. Defaults to
                                     # `brand`. Env override: AGNES_INSTANCE_BRAND_SHORT.
  # experience: "redesign"          # ONE-LINE experience preset. Retired as a CHOICE
                                     # (Wave 0, 2026-08): "redesign" is the only valid
                                     # value now, and the default even when this key is
                                     # absent — the old "classic" value (or any other
                                     # unrecognised string) falls back to "redesign",
                                     # with a one-time startup warning naming the
                                     # ignored setting. Kept only so an older
                                     # instance.yaml with `experience: classic` still
                                     # boots without error.
                                     # Historically flipped the DEFAULTS of the coupled
                                     # knobs (theme=paper, features.stack_auto_membership
                                     # =true — `ui_layout` was dropped from the coupling
                                     # when the rail chrome became the only chrome); any
                                     # per-knob setting below (env or yaml) still wins.
                                     # Env override: AGNES_INSTANCE_EXPERIENCE.
  # theme: "blue"                    # UI palette: paper (default) | blue | navy | dark |
                                     # auto. `paper` (warm paper canvas, emerald accent,
                                     # pill CTAs) became the default in Wave 0 (2026-08);
                                     # set "blue" (or any other value) explicitly to opt
                                     # out — an explicit theme choice always wins. Env
                                     # override: AGNES_INSTANCE_THEME.
  # ui_layout: "rail"                # RETIRED, no-op (Wave 0, 2026-08): the rail chrome
                                     # (fixed left sidebar) is the only chrome now —
                                     # `topnav` no longer exists. Setting this key (or
                                     # AGNES_UI_LAYOUT) to anything is ignored, with a
                                     # one-time startup warning; kept only so an older
                                     # instance.yaml still boots.
  # workspace_dir: "FoundryAI"       # Filesystem-safe folder name for the analyst's local
                                     # workspace (~/<workspace_dir>). When unset, derived from
                                     # `brand` by stripping non-alphanumerics ("Foundry AI" ->
                                     # "FoundryAI"). Set explicitly only if you want a folder
                                     # name that differs from the auto-derivation. Env override:
                                     # AGNES_WORKSPACE_DIR_NAME.
  # logo_svg: |                      # Inline <svg> element rendered into the header brand slot
  #   <svg width="120" height="30" viewBox="0 0 100 30" xmlns="http://www.w3.org/2000/svg">
  #     <text y="22" font-size="24" fill="#333">Logo</text>     # and above the Sign In card on /login.
  #   </svg>
  #                                  # When set, the SVG replaces the text brand in the header.
  #                                  # `name` above still drives browser <title> text and page
  #                                  # headings — keep it populated. Env override:
  #                                  # AGNES_INSTANCE_LOGO_SVG.
  # favicon: "img/my-icon.png"       # Favicon href. A path (no leading slash) is resolved
                                     # as a static asset under app/web/static/ (same
                                     # cache-busting `static_url()` every other asset gets);
                                     # a data: URI or an absolute URL (contains "://") is used
                                     # verbatim instead. Default: the built-in agnes-orb icon.
                                     # Env override: AGNES_INSTANCE_FAVICON.
  # overview: |                      # Operator-authored Overview body rendered inside the
  #   <p>Free-form HTML — paragraphs, links, lists.</p>
  #                                  # welcome hero on /home (hairline-separated footnotes
  #                                  # below the four-pillar row). Use for product framing,
  #                                  # privacy posture, what-data-flows summary —
  #                                  # operator-specific copy stays out of the OSS this way.
  #                                  # HTML in, HTML out (same `| safe` filter as news_intro).
  #                                  # Empty/unset = block hidden.
  #                                  # Env override: AGNES_INSTANCE_OVERVIEW.
  # support: |                       # Operator-authored Support body rendered in a
  #   <p><strong>Need help?</strong> Drop into our <a href="...">Support</a> chat space.</p>
  #                                  # mint-accent panel inside the welcome hero on /home
  #                                  # (below the Overview footnotes). Use to point analysts
  #                                  # at a chat space, mailing list, or runbook so they know
  #                                  # where to ask for help. HTML in, HTML out (same `| safe`
  #                                  # filter as overview). Empty/unset = block hidden.
  #                                  # Env override: AGNES_INSTANCE_SUPPORT.
  # hide_login_features: [mcp]       # Feature-cards to hide on the /login left panel.
  #                                  # Accepts a YAML list ([mcp, memory]) or a comma-
  #                                  # separated string ("mcp,memory"). Valid keys:
  #                                  # data, marketplace, mcp, memory, anywhere. Empty/
  #                                  # unset hides nothing (default). Env override:
  #                                  # AGNES_INSTANCE_HIDE_LOGIN_FEATURES.
  # custom_preamble: |               # Plain-text block injected at the TOP of the `agnes init`
  #   Trust note: {instance_brand} is operated internally.
  #                                  # install prompt (above "Set up the … CLI"). {instance_brand}
  #                                  # etc. are substituted; do NOT use {server_url}/{token}.
  #                                  # Empty/unset = default prompt unchanged. Env override:
  #                                  # AGNES_INSTANCE_CUSTOM_PREAMBLE.
  # sync_interval: "1 hour"          # Cadence shown in analyst CLAUDE.md (e.g., "1 hour", "30 minutes", "daily")
  # admin_email: "ops@acme.com"      # Operator contact shown on /home GWS connector tile as
                                     # an "Email admin" mailto button (analysts whose operator
                                     # hasn't pre-provisioned a shared OAuth app can request
                                     # one without leaving the workspace). Empty/unset hides
                                     # the button. Env override: AGNES_INSTANCE_ADMIN_EMAIL.
  # home:                            # Per-instance toggles for /home content blocks.
  #   show_automode: true            # Render Step-3 auto-accept-mode block. Default true.
  #                                  # Env: AGNES_HOME_SHOW_AUTOMODE.
  #   show_status_frame: true        # Render the 5-card status frame (Last sync, Sessions,
  #                                  # Prompts, Tokens, Projects). Visible only to onboarded
  #                                  # users regardless of this flag. Default true. Env:
  #                                  # AGNES_HOME_SHOW_STATUS_FRAME.
  # custom_scripts:                  # Operator-injected HTML/JS blocks rendered into every
  #                                  # page that extends base.html. Use for feedback widgets
  #                                  # (Marker.io), analytics (GTM, PostHog), error capture
  #                                  # (Sentry), etc. Each entry needs name + enabled +
  #                                  # placement + html. Admin-only; rendered with `| safe`.
  #                                  # Review the widget's privacy posture before enabling —
  #                                  # most third-party widgets capture screenshots, console
  #                                  # logs, or user actions on submit. Resolved by
  #                                  # `app/instance_config.py::get_custom_scripts()`. No
  #                                  # env override (structure doesn't fit env vars cleanly).
  #   - name: "marker-io"            # Example: Marker.io feedback widget.
  #     enabled: true                # Kill switch — set false to disable without deleting.
  #     placement: "head_end"        # head_start | head_end | body_end
  #     html: |
  #       <script>
  #         window.markerConfig = {
  #           project: 'YOUR_MARKER_IO_PROJECT_ID',
  #           source: 'snippet'
  #         };
  #         !function(e,r,a){if(!e.__Marker){e.__Marker={};var t=[],n={__cs:t};["show","hide","isVisible","capture","cancelCapture","unload","reload","isExtensionInstalled","setReporter","clearReporter","setCustomData","on","off"].forEach(function(e){n[e]=function(){var r=Array.prototype.slice.call(arguments);r.unshift(e),t.push(r)}}),e.Marker=n;var s=r.createElement("script");s.async=1,s.src="https://edge.marker.io/latest/shim.js";var i=r.getElementsByTagName("script")[0];i.parentNode.insertBefore(s,i)}}(window,document);
  #       </script>

# --- Server ---
server:
  hostname: ""                    # DNS name (e.g., "data.acme.com")
  host: ""                        # IP address
  app_dir: "/opt/data-analyst"    # Installation directory
  # public_url: ""                # Absolute base URL, e.g. "https://data.acme.com".
                                  # Used to build absolute links from request-less
                                  # surfaces — notably the Slack bot's /slack/bind
                                  # magic links. The PUBLIC_URL env var overrides this.
  # --- Client setup (shown in "Get Started" on dashboard) ---
  # ssh_alias: "data-analyst"     # SSH config Host alias for analysts (default: "data-analyst")
  # ssh_key: "~/.ssh/data_analyst_server"  # SSH key path for analysts (default: "~/.ssh/data_analyst_server")
  # project_dir: "data-analyst"   # Local project folder name (default: "data-analyst")

# --- Admin users ---
# Manage the server, own data files, get unlimited resource limits.
# SSH keys are used by server/setup.sh during provisioning.
admins:
  - username: "admin"
    ssh_public_key: "ssh-ed25519 AAAA..."

# --- Deployment ---
deployment:
  method: "manual"                # manual | github_actions
  repo_url: ""                    # e.g., "git@github.com:acme/ai-data-analyst.git"
  branch: "main"
  # role: "all"                    # api | gateway | worker | all, comma-separable (e.g. "api,gateway").
                                   # AGNES_ROLE env var overrides this. Default "all" keeps the
                                   # single-process, zero-ops S-tier behavior. Splitting into
                                   # api/gateway/worker replicas requires coordination.backend=redis
                                   # and (for a shared analytics.backend=ducklake catalog) a Postgres
                                   # ducklake.catalog_dsn — see app/roles.py + app/startup_guards.py.

# --- Coordination backend (multi-process deployments only) ---
# In-process memory (default) is zero-config and correct for a single "all"-role
# process. Running api/gateway/worker as separate replicas needs a shared
# backend for WS auth tickets, session-routing leases, rate limiting, etc.
# coordination:
#   backend: "memory"              # memory | redis. AGNES_COORDINATION_BACKEND env var overrides this.
#
# redis:
#   url: "redis://localhost:6379/0"  # Only consulted when coordination.backend is "redis".
                                      # AGNES_REDIS_URL env var overrides this.

# --- Analytics backend (server-side query engine) ---
# "legacy" (default) is today's rebuilt-and-swapped analytics.duckdb file — no
# extra config needed. "ducklake" moves the query surface to a DuckLake catalog
# (storage/compute separation, scales by adding stateless reader replicas) — see
# docs/DEPLOYMENT.md's DuckLake section and
# docs/superpowers/specs/2026-07-16-three-plane-scalable-architecture.md §3.4.
# analytics:
#   backend: "legacy"              # legacy | ducklake. AGNES_ANALYTICS_BACKEND env var overrides this.
#
# ducklake:
#   # catalog_dsn: ""              # Postgres DSN (postgresql://...), REQUIRED for any multi-process
                                    # topology (a DuckDB-file catalog only works single-process — see
                                    # app.startup_guards.validate_deployment). Left unset, defaults to
                                    # a DuckDB-file catalog at {DATA_DIR}/analytics/catalog.ducklake.
                                    # AGNES_DUCKLAKE_CATALOG_DSN env var overrides this (recommended —
                                    # keeps the DSN's credentials out of this file).
#   # data_path: ""                # Directory where DuckLake stores its own data files. Defaults to
                                    # {DATA_DIR}/analytics/lake/. AGNES_DUCKLAKE_DATA_PATH env var
                                    # overrides this.
#   # snapshot_retention_days: 7   # Days of DuckLake snapshot history the daily ducklake-maintenance
                                    # job keeps before expiry/cleanup. AGNES_DUCKLAKE_SNAPSHOT_RETENTION_DAYS
                                    # env var overrides this.

# --- Authentication ---
# At minimum, set allowed_domain and webapp_secret_key.
# Password sign-in works out of the box (no external service needed).
# Google OAuth is optional - add credentials to enable it.
auth:
  allowed_domain: ""              # Email domain(s) for login, comma-separated (e.g., "acme.com" or "acme.com, partner.org")
  webapp_secret_key: "${WEBAPP_SECRET_KEY}"
  # Optional: Google OAuth (if not set, only password sign-in is offered)
  google_client_id: "${GOOGLE_CLIENT_ID}"
  google_client_secret: "${GOOGLE_CLIENT_SECRET}"

  # providers: [google, email, password, keboola, microsoft]
  #                                 # Which login methods this instance offers.
  #                                 # Unset = every configured provider EXCEPT
  #                                 # `email` (default) — the magic link's
  #                                 # single-use verify link can be silently
  #                                 # burned by a corporate mail scanner
  #                                 # before the human clicks, so it is
  #                                 # opt-in only: list `email` explicitly to
  #                                 # offer it. Explicit empty list is
  #                                 # rejected. Excluded providers' endpoints
  #                                 # return 404. Env override:
  #                                 # AGNES_AUTH_PROVIDERS (comma-sep).

  # --- Keboola login (optional) ---
  # Lets users sign in with their Keboola platform identity. The OAuth
  # client (client_id/client_secret) is issued by Keboola for your stack —
  # ask your Keboola contact; it is not self-service. The token-header API
  # auth (auth.keboola.allow_token_header switch) works without any OAuth
  # client. Membership in project_id is the trust boundary: ANYONE that
  # project admits (including guest/readOnly collaborators) can sign in and
  # self-provision unless allowed_roles narrows it.
  #
  # Multi-project mode (multi_project_mode: select|auto) discovers every
  # project the signing-in user can reach (introspect on the OAuth host,
  # narrowed by allowed_roles) and — in 'auto' — connects them without any
  # hand-copied tokens: a project-scoped PAT is minted per project and
  # vaulted (needs AGNES_VAULT_KEY), a source connection + chat tools are
  # provisioned, the user's kbc-<project>-<role> group memberships are
  # synced on every login, and the semantic layer refreshes for projects
  # whose minted token is a master token. 'select' stores the discovery for
  # a user-driven import via /api/auth/keboola/projects instead. With
  # project_id: "*" (or unset) the login trust boundary becomes "reaches at
  # least one allowed-role project"; a concrete project_id keeps the
  # single-project gate and narrows discovery to that project.
  #
  # WILDCARD ON A SHARED STACK: a Keboola role is per-project, and every
  # user is admin of their own project — so on a multi-tenant stack the
  # wildcard admits ANY user of the stack, even with allowed_roles:
  # [admin]. allowed_roles narrows WHICH OF A USER'S PROJECTS take part,
  # never which organization may sign in. Use "*" only on a dedicated
  # (single-organization) stack; on a shared stack pin a concrete
  # project_id.
  # keboola:
  #   client_id: "${KEBOOLA_OAUTH_CLIENT_ID}"
  #   client_secret: "${KEBOOLA_OAUTH_CLIENT_SECRET}"
  #   stack_url: ""                 # default: data_source.keboola.stack_url
  #   oauth_host: ""                # default: stack_url (OAuth lives on the connection host)
  #   project_id: ""                # REQUIRED unless multi_project_mode is select/auto;
  #                                 # "*" = any project (multi-project wildcard)
  #   allowed_roles: []             # e.g. [admin, share]; empty/unset = any project role
  #   allow_token_header: false     # X-StorageApi-Token API auth; see docs/feature-flags.md
  #   multi_project_mode: disabled  # disabled | select | auto; see docs/feature-flags.md

# --- Security (optional) ---
# security:
#   # Hostnames exempt from the private/reserved-network SSRF guard on admin-
#   # configured URLs. The check lives in the shared validator, so a listed host
#   # is exempt on EVERY admin URL that routes through it — the marketplace +
#   # initial-workspace clone URLs (git-cloned server-side), the Keboola
#   # stack_url, and URL-bearing server-config fields (data_source.keboola.
#   # stack_url, marketplace.curators_url) — not just clone URLs. By default any
#   # host resolving to a private/reserved/loopback/link-local address is
#   # rejected; list an internal host here (e.g. an on-prem GitHub Enterprise on
#   # a private network) to allow it. Accepts a YAML list ([git.internal,
#   # ghe.corp]) or a comma-separated string ("git.internal,ghe.corp").
#   # Empty/unset (default) keeps the guard fail-closed. Env override:
#   # AGNES_SSRF_ALLOWED_HOSTS.
#   ssrf_allowed_hosts: []

# --- MCP sources (optional) ---
# mcp:
#   # Require an MCP source's own `url` to be https to a public, resolvable
#   # address — the same bar its OAuth endpoints are held to. Every forward to
#   # an http/sse source dials this url with a user credential attached, so it
#   # is checked when configured rather than when a caller trips over it.
#   #
#   # OFF IS NOT UNGUARDED. Either way Agnes refuses link-local/metadata,
#   # multicast and reserved addresses, and cleartext http to a public address.
#   # What `false` additionally permits is a source on an INTERNAL address —
#   # an organization's own tool server, a developer's localhost — recorded in
#   # the audit row rather than blocked, because those are ordinary
#   # deployments. Turn this on for instances that only ever talk to
#   # third-party MCP services.
#   #
#   # Strict mode honours `security.ssrf_allowed_hosts` above, so a single
#   # on-prem source does not stop an instance from adopting it.
#   # Env override: AGNES_MCP_SOURCE_URL_STRICT.
#   source_url_strict: false
#
#   # Expose the user-facing MCP connector surface — Agnes's OWN server, i.e.
#   # the /me/ai-connector and /mcp-connect install-instruction pages, the MCP
#   # tab of /how-it-works#connect, and their nav/palette entries. On by
#   # default (current behavior). Set false on a VPN/intranet-only instance
#   # whose cloud-side MCP clients (e.g. a hosted connector resolved from
#   # outside the network) can never reach the endpoint, so users are not
#   # shown a setup path that cannot work for them. UI only — the MCP
#   # protocol endpoints (/api/mcp/http, /api/mcp/sse) keep serving in-network
#   # clients regardless. See docs/DEPLOYMENT.md. Env override:
#   # AGNES_MCP_CONNECTOR_UI_ENABLED.
#   connector_ui_enabled: true

# --- Access control (optional) ---
# access:
#   # Default admin elevation for BROWSER sessions that have not chosen:
#   # "elevated" (historical behavior — the Admin group short-circuits
#   # every access check) or "paused" (consent-first: admins browse with
#   # only their explicit group grants until they enable admin mode on
#   # /profile). A per-browser choice via POST /api/me/elevation always
#   # wins over this default. Bearer-authenticated automation (agnes CLI,
#   # PATs, service tokens) is never subject to this default — it has no
#   # cookie jar to re-elevate with. See docs/RBAC.md.
#   admin_default_elevation: "elevated"

# --- Feature flags (optional) ---
# See docs/feature-flags.md for the full inventory and resolution order.
# features:
#   stack_auto_membership: false     # Stack membership mode. true (the default, since
#                                    # Wave 0, 2026-08 — `experience` is always
#                                    # "redesign" now): auto-membership — every granted
#                                    # resource is in the stack immediately;
#                                    # subscribe/unsubscribe only control the local
#                                    # copy. false: the classic subscribe model —
#                                    # required plus subscribed grants, all downloaded
#                                    # by `agnes pull` — still fully supported; an
#                                    # explicit false always wins over the default. Part
#                                    # of the redesign pair (theme=paper, this flag) —
#                                    # set both at once with `instance.experience:
#                                    # redesign` above. Env override:
#                                    # AGNES_STACK_AUTO_MEMBERSHIP.

# --- Library & Store trust vocabulary (optional, opt-in) ---
# Both default to false so a routine upgrade never changes what existing
# instances render. Turn them on together to adopt the positive
# Organization / Verified / Community provenance markers and the
# admin-driven verification workflow. Env overrides:
# AGNES_LIBRARY_SHOW_UNVERIFIED_TRUST; store.verification_enabled is
# yaml/admin-overlay only.
# library:
#   show_unverified_trust: true      # 'Community' marker on unverified Store items
# store:
#   verification_enabled: true       # "Request verification" + admin Verify workflow

# --- Theme (optional) ---
# Customize colors, fonts, and shape to match your brand.
# All values are optional - defaults provide a clean blue theme.
# See docs/theme-reference.html for a visual guide.
#
# Recolors BOTH the legacy chrome AND the design-system ("paper"/"navy"/
# "dark") surfaces from this one block — no forking, no custom CSS. Known
# color keys also set the matching --ds-* token (primary -> --ds-primary,
# background -> --ds-bg, surface -> --ds-surface, border -> --ds-border,
# text_primary -> --ds-text-primary, text_secondary -> --ds-text-secondary,
# success/warning/error -> --ds-accent-{success,warn,danger}-ink). See
# THEME_CSS_VAR_MAP in app/instance_config.py for the full mapping;
# font_primary/radius stay legacy-only (no single --ds-* equivalent) and
# font_url isn't a CSS variable at all.
theme:
  # primary: "#0073D1"              # Main brand color (buttons, links, accents)
  # primary_dark: "#005BA3"         # Hover/active state of primary
  # primary_light: "rgba(0, 115, 209, 0.1)"  # Light tint backgrounds
  # text_primary: "#1A253C"         # Main text color
  # text_secondary: "#6B7280"       # Muted/secondary text
  # background: "#F5F7FA"           # Page background
  # surface: "#FFFFFF"              # Card/panel background
  # border: "#E5E7EB"              # Borders and dividers
  # font_primary: "'Inter', system-ui, sans-serif"
  # font_url: "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  # radius: "6px"                   # Border radius (cards, buttons, inputs)
  # success: "#10B77F"
  # warning: "#F59F0A"
  # error: "#EA580C"

# --- Data source ---
data_source:
  type: "keboola"                 # keboola | bigquery | local
  keboola:
    storage_token: "${KEBOOLA_STORAGE_TOKEN}"
    stack_url: ""                 # e.g., "https://connection.keboola.com"
    project_id: ""
  bigquery:
    project: "${BIGQUERY_PROJECT}"       # GCP project hosting the data (used in FROM clause)
    location: "${BIGQUERY_LOCATION}"     # BigQuery location (e.g., "us-central1", "US")
    # Uses ADC (Application Default Credentials) - VM service account on GCP
    # Data can live in a different project -- use fully-qualified table IDs in data_description.md
    # billing_project: "prj-billing"     # GCP project to bill BQ jobs to / submit jobs from.
    #                                    # Defaults to `project`. Set when the SA has bigquery.data.* on
    #                                    # the data project but lacks serviceusage.services.use there.
    #                                    # Mismatch -> every BQ call 403 USER_PROJECT_DENIED.
    #                                    # `da diagnose` warns when this falls back to `project`.
    #                                    # Configurable via /admin/server-config UI.
    # max_bytes_per_materialize: 10737418240
    #                                    # Cost guardrail (bytes) for query_mode='materialized' BQ scans.
    #                                    # Dry-run check before running; exceeding -> registration / sync
    #                                    # rejected. Default 10 GiB (10737418240). Set 0 to disable.
    #                                    # null falls through to default. Configurable via /admin/server-config UI.
    # materialize_fetch_timeout_seconds: 900
    #                                    # Watchdog (seconds) on the COPY's client-side result download
    #                                    # during materialize — the phase the extension's query timeout
    #                                    # does not cover. On expiry the connection is interrupted and the
    #                                    # COPY retried once on a fresh session. Default 900. Set 0 to disable.
    # query_timeout_ms: 600000
    #                                    # DuckDB BigQuery extension query timeout (milliseconds).
    #                                    # Applied via `SET bq_query_timeout_ms` after every LOAD bigquery
    #                                    # on every BQ-touching DuckDB session. Extension default is
    #                                    # 90 000 ms = 90 s, which is too tight for analyst queries against
    #                                    # view-backed datasets -- bumped to 600 000 ms = 10 min by default.
    #                                    # Set 0 to fall through to the extension default. Configurable via
    #                                    # /admin/server-config UI.
    # session_pool_size: 4
    #                                    # Number of pre-warmed DuckDB+bigquery-extension sessions kept
    #                                    # in a process-local pool. Each acquire amortizes the
    #                                    # ~0.5 s INSTALL/LOAD/CREATE-SECRET cost across requests; a fresh
    #                                    # build only happens when the pool is empty. Default 4. Set 0
    #                                    # to disable pooling (every acquire builds + closes a fresh
    #                                    # session; matches pre-pool behavior).
  # databricks:                          # Databricks SQL warehouse (secondary source; rows register with
  #                                      # source_type=databricks + query_mode='materialized'). The scheduler
  #                                      # runs each row's SQL on the warehouse via the Statement Execution
  #                                      # API and distributes the parquet like any other materialized row.
  #                                      # Also drives the Unity Catalog metric-view (semantic layer) sync
  #                                      # into metric_definitions. All fields editable via /admin/server-config.
  #   host: "${DATABRICKS_HOST}"         # Workspace URL, e.g. "https://dbc-a1b2c3d4-e5f6.cloud.databricks.com".
  #                                      # https-only, no path. Token comes from the env var named by
  #                                      # token_env (default DATABRICKS_TOKEN) or the vault — never YAML.
  #   warehouse_id: "${DATABRICKS_WAREHOUSE_ID}"  # SQL warehouse ID (Connection details tab).
  #   catalog: "main"                    # Default Unity Catalog catalog: `bucket` on registered rows is a
  #                                      # schema inside it (dotted bucket "catalog.schema" overrides per
  #                                      # row); the semantic-layer sync enumerates its metric views.
  #   token_env: "DATABRICKS_TOKEN"      # Env var holding the PAT / OAuth M2M access token.
  #   max_bytes_per_materialize: 10737418240
  #                                      # Cost guardrail (bytes) for materialized Databricks rows. Caps the
  #                                      # statement RESULT size via the API's byte_limit (no dry-run
  #                                      # primitive exists, unlike BigQuery); a truncated result is
  #                                      # rejected, never written. Default 10 GiB. Set 0 to disable.
  #   statement_timeout_seconds: 900     # Client-side deadline on a materialize statement; on expiry the
  #                                      # statement is cancelled on the warehouse. Default 900. 0 disables.
  #   semantic_layer_catalogs: []        # Optional extra catalogs (list or comma string) the metric-view
  #                                      # sync should enumerate; defaults to [catalog].
  #   max_bytes_per_remote_query: 1073741824
  #                                      # Cost guardrail for interactive `agnes query --remote` against
  #                                      # query_mode='remote' rows. Caps the bytes the warehouse may RETURN
  #                                      # (byte_limit) — not bytes scanned, which Databricks does not expose.
  #                                      # A capped result is refused, never returned short. Default 1 GiB.
  #   remote_query_timeout_seconds: 120  # Deadline on an interactive remote query (a human is waiting).
  #   scan_timeout_seconds: 900          # Deadline on a SNAPSHOT statement (`agnes snapshot create` /
  #                                      # /api/v2/scan). Longer than the interactive one on purpose: a
  #                                      # snapshot is a materialize, not an answer someone is waiting on.
  #                                      # Its SIZE bound is api.scan.max_result_bytes, not the interactive
  #                                      # max_bytes_per_remote_query. Default 900. 0 disables.
  #   attach_enabled: false              # EXPERIMENTAL. Attach Unity Catalog into DuckDB via the uc_catalog +
  #                                      # delta community extensions so remote Databricks tables can be
  #                                      # JOINed against local parquets. Off by default: it installs
  #                                      # community extensions and sends the PAT to the workspace endpoint
  #                                      # — pin it with AGNES_REMOTE_ATTACH_HOST_ALLOWLIST. Without it,
  #                                      # remote rows still work; every statement runs on the warehouse.
  # snowflake:                           # Snowflake SQL warehouse (secondary source; rows register with
  #                                      # source_type=snowflake + query_mode='remote' or 'materialized').
  #                                      # The DuckDB Snowflake extension resolves live queries locally and
  #                                      # materialized rows write a parquet on the scheduler tick.
  #   account: "myaccount"               # Snowflake account identifier (e.g. xy12345 or xy12345.eu-central-1).
  #   user: "${SNOWFLAKE_USER}"          # Snowflake user name. Password comes from the env var named by
  #                                      # token_env (default SNOWFLAKE_PASSWORD) or the vault — never YAML.
  #   database: "ANALYTICS"              # Default database used when bucket/schema is given without a DB prefix.
  #   warehouse: "COMPUTE_WH"            # Warehouse used for materialized COPY statements and live queries.
  #   role: ""                           # Optional Snowflake role. Leave empty to use the user's default.
  #   auth_type: "password"             # "password" or "key_pair". For key_pair, set private_key_env
  #                                      # (default SNOWFLAKE_PRIVATE_KEY) and optional private_key_passphrase_env
  #                                      # (default SNOWFLAKE_PRIVATE_KEY_PASSPHRASE) instead of token_env.
  #   token_env: "SNOWFLAKE_PASSWORD"    # Env var holding the Snowflake password when auth_type=password.
  #   private_key_env: "SNOWFLAKE_PRIVATE_KEY" # Env var holding the PEM private key (or JSON key envelope) when auth_type=key_pair.
  #   private_key_passphrase_env: "SNOWFLAKE_PRIVATE_KEY_PASSPHRASE" # Optional env var holding the private key passphrase.
  #   max_bytes_per_materialize: 10737418240
  #                                      # Cost guardrail (bytes) for materialized Snowflake rows. Caps the
  #                                      # parquet size; a larger result is rejected, never written.
  #                                      # Default 10 GiB. Set 0 to disable.

# --- OpenMetadata catalog (optional) ---
# Enriches table and column metadata from OpenMetadata REST API.
# If not configured, app works normally without catalog enrichment.
# All openmetadata.* fields configurable via /admin/server-config UI.
# openmetadata:
#   url: "https://your-catalog.example.com"
#   token: "${OPENMETADATA_TOKEN}"        # JWT bearer token
#   cache_ttl_seconds: 3600               # Cache TTL in seconds
#   verify_ssl: true                       # set to false ONLY for internal
#                                          # CAs / self-signed certs; defaults
#                                          # to true. Setting false ships the
#                                          # JWT over an unverified channel.

# --- Email delivery (optional, for magic link auth) ---
# Without SMTP, magic links are shown directly in browser (development mode).
# For production, configure any SMTP relay (Gmail, Mailgun, SendGrid SMTP, etc.)
email:
  # Sender address. `SMTP_FROM` (or the legacy `EMAIL_FROM_ADDRESS`) wins if
  # set; this value is the fallback.
  from_address: "noreply@example.com"
  # NOT IMPLEMENTED — the SMTP transport sends a bare address with no display
  # name, so this key is inert. Left in place because removing it would silently
  # drop it from existing instance.yaml files on the next template diff.
  from_name: "AI Harness"
  smtp_host: "${SMTP_HOST}"          # e.g., "smtp.gmail.com"
  smtp_port: 587                     # 587 for STARTTLS, 465 for SSL
  smtp_user: "${SMTP_USER}"
  smtp_password: "${SMTP_PASSWORD}"

# --- Telegram notifications (optional) ---
telegram:
  bot_token: "${TELEGRAM_BOT_TOKEN}"
  bot_username: ""
  domain_suffix: ""

# --- Operator alerting (optional) ---
# When a SCHEDULED sync fails, Agnes POSTs a concise {"text": ...} payload to
# this webhook so operators hear about it without watching the dashboard. The
# payload shape is the lowest common denominator across Slack, Google Chat,
# Mattermost and Discord incoming webhooks — point `alert_webhook_url` at
# whichever channel you already run. Best-effort: a webhook outage never blocks
# the sync. Leave empty (the default) to disable. Env override:
# AGNES_ALERT_WEBHOOK_URL.
notifications:
  alert_webhook_url: ""

# --- Jira integration (optional) ---
jira:
  domain: ""
  email: ""
  api_token: "${JIRA_API_TOKEN}"
  webhook_secret: "${JIRA_WEBHOOK_SECRET}"
  # Custom fields to refresh onto tickets (generic; no defaults). field_id or
  # field_id:column, comma-separated. Discover with:
  #   python -m connectors.jira.scripts.verify_sla_access --list-fields
  refresh_fields: "${JIRA_REFRESH_FIELDS}"
  cloud_id: ""  # set only for a scoped API token (gateway URL)

# --- Corporate Memory AI (optional) ---
# Extracts shared knowledge from team members' CLAUDE.local.md files.
# Provider: "anthropic" (direct API) or "openai_compat" (LiteLLM, OpenRouter, Azure, etc.)
ai:
  provider: "anthropic"                    # or "openai_compat"
  api_key: "${ANTHROPIC_API_KEY}"          # or "${LLM_API_KEY}" for proxy
  # base_url: "https://litellm.example.com"  # Required for provider='openai_compat' (LiteLLM,
                                              # OpenRouter, vLLM). Ignored when provider='anthropic'.
                                              # Configurable via /admin/server-config UI.
  model: "claude-haiku-4-5-20251001"       # any model available on your provider
  # --- Structured output quality control ---
  # AI models can return JSON in three ways, each with different reliability:
  #
  # Layer 1 - "json_schema" (best):
  #   The provider enforces an exact schema. Every field, type, and structure
  #   is guaranteed. Available on: Anthropic, OpenAI, Claude via LiteLLM.
  #
  # Layer 2 - "json_object" (good):
  #   The provider guarantees valid JSON, but does not enforce a specific schema.
  #   Fields may be missing or have wrong types. Available on most providers.
  #
  # Layer 3 - "prompt" (acceptable):
  #   The AI is asked to respond in JSON via instructions in the prompt.
  #   No technical enforcement -- the model may still return invalid JSON.
  #   Works everywhere, but least reliable.
  #
  # "strict" = only Layer 1. Fail if provider doesn't support json_schema.
  #            Use when data quality is non-negotiable.
  # "json"   = Layer 1, fall back to Layer 2. No prompt-based fallback.
  #            Good balance of quality and compatibility.
  # "auto"   = All three layers as progressive fallback. Maximum compatibility.
  #            Use when you'd rather get imperfect data than no data.
  structured_output: "auto"

# Legacy format (still supported, equivalent to provider: "anthropic"):
# ai:
#   anthropic_api_key: "${ANTHROPIC_API_KEY}"

# Examples:
# --- LiteLLM proxy ---
# ai:
#   provider: "openai_compat"
#   base_url: "https://litellm.example.com"
#   api_key: "${LLM_API_KEY}"
#   model: "claude-haiku-4-5-20251001"
#   structured_output: "strict"
#
# --- OpenRouter ---
# ai:
#   provider: "openai_compat"
#   base_url: "https://openrouter.ai/api/v1"
#   api_key: "${OPENROUTER_API_KEY}"
#   model: "anthropic/claude-3-haiku"
#   structured_output: "auto"

# --- Maintained digests (optional, K4) ---
# Admin-defined digest documents (title + standing instructions + source
# Collections) the scheduler regenerates via LLM only when the sources'
# content fingerprint changes (or the digest definition itself was edited).
# Provider/API key/model ride the ai: block above — this section only tunes
# the per-pass LLM budget. All three knobs default sanely if omitted; 0
# disables the corresponding budget/timeout gate.
#
# digests:
#   llm:
#     max_tokens: 4000                  # response cap per generation
#     max_generations_per_pass: 3       # LLM-call cap per scheduler pass (0 = unlimited)
#     timeout_seconds: 300              # wall-clock deadline per pass (0 = unlimited)

# --- Flea-market upload guardrails (optional) ---
# Controls the pre-publish check pipeline for skill/agent/plugin uploads
# to /store. See docs/STORE_GUARDRAILS.md for the full check catalogue.
#
# guardrails:
#   # Master kill-switch. When false, inline manifest/security/quality
#   # checks still run (they're free) but the LLM step is skipped and new
#   # uploads are auto-approved. Useful for local dev without an LLM key.
#   enabled: true
#
#   # Anthropic model tier for the LLM security review.
#   # haiku  — ~$0.001/review, default, good enough for routine uploads
#   # sonnet — ~$0.015/review, deeper reasoning, fewer false negatives
#   # opus   — ~$0.075/review, only for high-stakes deployments
#   # You can also pin a concrete model ID (e.g. "claude-haiku-4-5-20251001").
#   review_model: "haiku"
#
#   # Per-submitter daily cap on inline-blocked uploads. Bounds disk +
#   # admin-queue spam. Set to 0 to disable. Default 50.
#   blocked_quota_per_day: 50
#
#   # How many days to keep blocked bundle bytes on disk before the
#   # daily TTL job purges them. Submission row + sha256 + size always
#   # survive — only the bundle bytes go. Set to 0 to retain forever
#   # (rely on admin Delete). Default 30.
#   blocked_bundle_ttl_days: 30
#
#   # --- Skill linter configuration (optional) ---
#   # Controls thresholds for the skill-linter advisory system.
#   # See docs/skill-guidelines.md for the rule catalogue.
#
#   # SL002: Maximum body character length before bloat warning. Default 8000.
#   lint_max_body_chars: 8000
#
#   # Duplicate shortlist size — top N candidate skills fed to SL010's LLM
#   # confirmation (and the SL012 degraded fallback). Default 5.
#   lint_duplicate_top_n: 5
#
#   # Minimum hours between full-corpus lint audits (the audit self-guard).
#   # Default 144 (6 days).
#   lint_audit_min_interval_hours: 144

# --- Corporate Memory governance (optional) ---
# Controls how AI-extracted knowledge is reviewed and distributed.
# If not present, system operates in legacy mode (democratic wiki, no admin review).
#
# The corporate_memory.* schema is editable via /admin/server-config UI; you can
# also continue to manage it via this YAML file. The UI surfaces every leaf with
# a hint, so use it to discover the schema if this comment block has aged.
#
# corporate_memory:
#   # How knowledge reaches users:
#   # "mandatory_only" — admin controls everything, no user voting
#   # "admin_curated" — admin controls, users vote as feedback signal
#   # "hybrid" — mandatory from admin + optional from user voting (default)
#   distribution_mode: "hybrid"
#
#   # How new AI-extracted items enter the system:
#   # "review_queue" — nothing published without admin approval (default)
#   # "auto_publish" — items go live immediately, admin intervenes retroactively
#   # "threshold" — high-confidence auto-publish, low-confidence to review queue
#   approval_mode: "review_queue"
#
#   # Default review period for approved/mandatory items (months)
#   review_period_months: 6
#
#   # Notify km_admins about new pending items
#   notify_on_new_items: true
#
#   # --- V1 Context Engineering ---
#
#   sources:
#     claude_local_md:
#       enabled: true
#       confidence_base: 0.50
#     session_transcripts:
#       enabled: true
#       confidence_base: 0.60
#       max_turns_per_session: 100
#       detection_types:
#         - correction
#         - confirmation
#         - unprompted_definition
#
#   extraction:
#     model: "claude-haiku-4-5-20251001"
#     sensitivity_check: true
#     contradiction_check: true
#
#   confidence:
#     # Base score per extraction source. Key format: "source_type" or "source_type.detection_type"
#     base:
#       user_verification.correction: 0.90
#       user_verification.unprompted_definition: 0.90
#       user_verification.confirmation: 0.60
#       admin_mandate: 1.00
#       claude_local_md: 0.50
#       session_transcript: 0.50
#     # Per-key modifier step sizes applied to base when optional signals are present.
#     modifiers:
#       user_verification.correction:
#         additional_verifiers: 0.05    # per extra unique verifier
#       user_verification.unprompted_definition:
#         additional_verifiers: 0.05
#       user_verification.confirmation:
#         admin_confirmed: 0.20
#       session_transcript:
#         user_confirmed_in_session: 0.20
#     # Confidence decay applied to items as they age.
#     decay:
#       mode: exponential               # linear | exponential
#       half_life_months: 12            # used when mode=exponential
#       decay_rate_monthly: 0.02        # used when mode=linear
#       floor:
#         admin_mandate: 0.50           # admin policies don't silently decay to zero
#         user_verification: 0.40       # user-verified facts never fall below 0.40
#         default: 0.0
#
#   contradiction_detection:
#     enabled: true
#     max_candidates: 10
#
#   entity_resolution:
#     enabled: true
#     entities:
#       metrics: ["churn", "MRR", "ARR", "NPS", "CAC", "LTV"]
#       products: ["Platform", "API", "Dashboard"]
#
#   domain_owners:
#     finance: ["cfo@company.com"]
#     engineering: ["cto@company.com"]
#     product: ["pm@company.com"]
#
#   domains:
#     - finance
#     - engineering
#     - product
#     - data
#     - operations
#     - infrastructure

# --- User groups for audience targeting (optional) ---
# Used with Corporate Memory governance to target mandatory knowledge to specific groups.
#
# groups:
#   finance:
#     label: "Finance & Analytics"
#     members: ["analyst1@company.com", "analyst2@company.com"]
#   engineering:
#     label: "Engineering"
#     members: ["dev1@company.com", "dev2@company.com"]

# --- User display and permissions ---
# Corporate Memory avatars + optional km_admin flag for governance.
# users:
#   admin@company.com:
#     display_name: "Admin User"
#     km_admin: true              # Corporate Memory admin (approve/mandate knowledge)
#   analyst@company.com:
#     display_name: "Analyst User"
users: {}

# --- Optional datasets (sync settings UI) ---
datasets: {}

# --- Data catalog ---
catalog:
  categories: {}
  order: []

# --- Data profiler (optional) ---
# profiler:
#   sample_size: 500000              # If table > this, sample this many rows; otherwise use all
#   max_categorical_distinct: 50     # Treat as categorical if unique <= this
#   top_values_limit: 10             # Top values per categorical column
#   histogram_bins: 15               # Bins in histogram visualizations
#   sample_rows_limit: 5             # Sample rows to show in UI "Sample" tab
#   alert_high_missing_pct: 30.0     # Alert threshold for high missing %
#   alert_missing_pct: 5.0           # Alert threshold for missing %
#   alert_imbalance_pct: 60.0        # Alert threshold for imbalance %
#   alert_high_cardinality: 50       # Alert threshold for high cardinality columns

# --- Remote query (optional) ---
# Settings for remote BigQuery queries via `python -m src.remote_query`.
# Used when tables have query_mode: "remote" in data_description.md.
# remote_query:
#   timeout_seconds: 300              # BQ + DuckDB query timeout
#   max_result_rows: 100000           # Max rows in final output
#   max_bq_registration_rows: 500000  # Max rows per --register-bq sub-query
#   default_format: "table"           # Default output format
#   output_dir: "/tmp/remote_query"   # Directory for Parquet/CSV exports

# --- v2 API knobs (optional) ---
# Controls for the /api/v2/{catalog,schema,sample,scan,scan/estimate} endpoints.
# All values are optional — the defaults shown below are applied if keys are absent.
#
# api:
#   # --- Scan / fetch limits ---
#   scan:
#     max_limit: 10000000             # Hard row cap per /api/v2/scan request (default: 10 M)
#     max_result_bytes: 2147483648    # Hard byte cap on Arrow stream response: 2 GB (default)
#                                     # If exceeded, partial result returned with X-Agnes-Truncated header.
#     max_concurrent_per_user: 5      # In-flight /api/v2/scan requests allowed per user (default: 5)
#                                     # Note: quota is process-local; N replicas → effective N× cap.
#     max_daily_bytes_per_user: 53687091200  # Per-user daily byte quota: 50 GB (default). Resets at UTC midnight.
#     max_daily_estimates_per_user: 500  # Per-user daily cap on BILLABLE estimate statements (default: 500).
#                                     # Resets at UTC midnight. Applies to engines whose estimate is real
#                                     # compute rather than a free dry run (Databricks: a COUNT(*) on the
#                                     # warehouse). Those engines report no scanned-byte figure, so the byte
#                                     # quota above cannot bound them — this counts statements instead.
#                                     # BigQuery estimates are dry runs and are not counted here.
#     bq_cost_per_tb_usd: 5.00        # Cost rate shown in /api/v2/scan/estimate response (default: $5/TB)
#     request_timeout_seconds: 300    # Server-side timeout for a single scan request (default: 300 s)
#   # --- Discovery cache TTLs ---
#   catalog_cache_ttl_seconds: 300    # /api/v2/catalog response cache lifetime (default: 5 min)
#   schema_cache_ttl_seconds: 3600    # /api/v2/schema/{table_id} cache lifetime (default: 1 h)
#   sample_cache_ttl_seconds: 3600    # /api/v2/sample/{table_id} cache lifetime (default: 1 h)
#                                     # Admins can force-refresh via POST /api/v2/sample/{id}?refresh=true

# --- Materialize concurrency safety (optional) ---
# Concurrency safety net for the materialize path (BQ + Keboola). When
# two materialize attempts race for the same table_id, the second one
# raises MaterializeInFlightError and skips. The lock is held in a
# .parquet.lock sibling file; if a holder process is hard-killed before
# kernel-level flock release, the next attempt reclaims the lock once
# the file's mtime is older than this TTL.
#
# Default 86400 (24h) is generous on purpose — anything shorter risks
# a long-running COPY being interrupted by its own scheduler successor.
# Lower it only if you know your materialize never exceeds the new
# value AND your host has a habit of hard-killing processes.
# Min 60 (1 minute), max 604800 (7 days). Configurable via /admin/server-config UI.
materialize:
  lock_ttl_seconds: 86400

# --- Rolling state-DB recovery snapshot (optional) ---
# system.duckdb.pre-migrate is captured once per migration transition and
# never refreshed afterwards, so it goes stale within hours of normal
# operation (#379/#380). This section controls a SEPARATE, rolling-refreshed
# recovery aid: system.duckdb.rolling-snapshot/, a logical EXPORT DATABASE
# (Parquet + schema.sql) taken over the app's own system.duckdb connection —
# never a second connection to the file. Runs on the same in-process tick as
# the periodic CHECKPOINT (app/main.py's _state_checkpoint_loop). DuckDB-
# backend only; a no-op when app-state lives in Postgres (its own backup
# story applies there). See docs/runbooks/wal-recovery.md for how to use it.
#
# backups:
#   # Hours between refreshes; 0 disables the rolling snapshot entirely.
#   # Default 6.
#   rolling_snapshot_interval_hours: 6

# --- Cloud-hosted Claude Code (optional) ---
# Cloud-hosted Claude Code (web /chat + Slack adapter). Off by default;
# turn on per-instance once you've built the E2B sandbox template and
# set ANTHROPIC_API_KEY + E2B_API_KEY in the Agnes server env. See
# docs/cloud-chat.md for the operator walkthrough.
chat:
  enabled: false
  # Sandbox provider:
  #   e2b       — cloud microVMs (needs an E2B account + a built template).
  #   docker    — self-hosted containers on the local Docker daemon, created
  #               through the apps-runner sidecar (compose profile `apps`).
  #               No E2B account; the workspace is bind-mounted instead of
  #               uploaded, so there is no 100 MB cap. See docs/cloud-chat.md
  #               → "Docker provider (self-hosted)".
  #   kai-agent — sessions run on the embedded kai-agent turn engine (the
  #               /api/kai/* integration; requires KAI_HOST_JWT_SECRET).
  #               The engine owns the agent loop, transcript and sandbox;
  #               Agnes spawns nothing per session. See docs/cloud-chat.md
  #               → "kai-agent provider (embedded turn engine)".
  # There is deliberately no mock provider.
  provider: e2b
  # Where the embedded engine listens (provider=kai-agent only). Default is
  # the compose service the customer-instance module materializes.
  # Overridable from the environment as AGNES_CHAT_KAI_AGENT_URL (env > this
  # key > default), same precedence as AGNES_CHAT_PROVIDER — infrastructure
  # that pins the provider has to be able to pin its endpoint too. It is also
  # what makes the provider reachable from a laptop, where the default names a
  # compose host that does not resolve: see docs/kai-agent-local-dev.md for
  # the local stub engine that lets you exercise this provider without the
  # real one.
  # kai_agent_url: "http://kai-agent:3000"
  # E2B template id returned by `e2b template build` inside
  # app/initial_workspace_default/e2b-template/. Required when
  # provider=e2b and enabled=true; startup gate refuses otherwise.
  # e2b_template_id: "agnes-chat"
  # Per-spawn workspace push cap. Files past this cap → user-facing
  # workspace_too_large error. 100 MB default keeps spawn latency in
  # the 3-5 s range. (provider=e2b only — docker bind-mounts.)
  e2b_workspace_max_bytes: 104857600
  # --- provider: docker -------------------------------------------------
  # Operator-built sandbox image (docker build -t agnes-chat-sandbox:latest
  # app/initial_workspace_default/docker-sandbox). The sidecar additionally
  # enforces CHAT_SANDBOX_IMAGE_PREFIX, so a tag outside that prefix is
  # refused at create time.
  # docker_image: "agnes-chat-sandbox:latest"
  # Docker network the sandbox joins. Must be one the Agnes app is also on,
  # or AGNES_SERVER won't resolve from inside the container.
  # docker_network: "agnes-apps"
  # Per-sandbox resource bounds — always applied (a local sandbox competes
  # with the gateway for host resources, unlike an E2B microVM).
  # docker_mem_limit: "2g"
  # docker_cpus: 1.0
  # docker_pids_limit: 512
  # open — normal bridge, internet reachable (in-sandbox `pip install` etc.
  #        keep working; weaker than E2B's hostname allowlist).
  # none — internal-only network: the sandbox reaches nothing but the
  #        containers on that network (stronger than E2B; breaks in-sandbox
  #        package installs).
  # allowlist — the internal network of `none` PLUS the egress-proxy sidecar
  #        (compose profile `chat-docker-egress`): sandboxes get HTTP(S)_PROXY
  #        pointed at it and may reach only docker_egress_allow_hosts, each
  #        connection re-checked post-DNS against link-local/metadata/private
  #        ranges (DNS-rebinding protection). Ignoring the proxy is not a
  #        bypass — the internal network has no other route out.
  # docker_egress_mode: open
  # Hostnames reachable in allowlist mode (exact or *.suffix wildcards).
  # Cloud metadata endpoints stay blocked even if listed.
  # docker_egress_allow_hosts: [pypi.org, "*.pypi.org", files.pythonhosted.org]
  # Where sandboxes find the proxy (compose service name on the internal net).
  # docker_egress_proxy_url: "http://agnes-egress-proxy:3128"
  # Host-wide ceiling on live sandboxes, on top of concurrency_per_user.
  # docker_max_total_sandboxes: 10
  # Kill the sandbox the moment the WS disconnects rather than
  # waiting for the idle reaper. Cuts billable sandbox-minutes on
  # UI close.
  e2b_kill_on_ws_disconnect: true
  # Agent harness driving the in-sandbox session. "claude-code" is the
  # only approved engine today; the id exists as the extension seam
  # (app/chat/harness.py) so an alternative can plug in behind the same
  # frame protocol. Unknown values refuse chat at boot.
  harness: "claude-code"
  concurrency_per_user: 3
  idle_ttl_seconds: 1800              # 30 min
  per_tool_call_seconds: 90
  per_session_bq_scan_bytes: 21474836480   # 20 GiB
  daily_anthropic_spend_usd: 20.0
  max_session_seconds: 14400
  max_session_tokens: 200000
  rate_messages_per_hour: 100
  tool_calls_per_turn_budget: 50
  # How long the in-runner approval gate waits for the user to answer an
  # approval card (workspace-hook "ask" verdicts) before denying the
  # suspended tool call.
  approval_timeout_seconds: 300
  marketplace_sha_debounce_seconds: 300
  # How the chat broker authenticates to Anthropic:
  #   api_key           (default) — use the static ANTHROPIC_API_KEY.
  #   workload_identity           — keyless: mint a short-lived token from the
  #                                 workload's own OIDC identity via Anthropic
  #                                 Workload Identity Federation. No long-lived
  #                                 key anywhere. Requires the federation env to
  #                                 be set (ANTHROPIC_FEDERATION_RULE_ID,
  #                                 ANTHROPIC_ORGANIZATION_ID,
  #                                 ANTHROPIC_SERVICE_ACCOUNT_ID, and
  #                                 ANTHROPIC_IDENTITY_TOKEN or
  #                                 ANTHROPIC_IDENTITY_TOKEN_FILE) and that
  #                                 ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN be
  #                                 unset. See docs/superpowers/specs/2026-07-15-
  #                                 keyless-llm-auth-design.md.
  # llm:
  #   auth: api_key

# --- Hosted Data Apps (optional) ---
# Hosted data apps (user web applications run next to the data)
data_apps:
  enabled: false
  runtime_image: "keboolapublic.azurecr.io/data-app-python-js:1.6.2_python-3.13_node-24"
  subdomain_base: ""            # e.g. "apps.example.com"; "" = path-prefix only
  default_idle_timeout_s: 1800
  default_sleep_mode: recreate  # recreate | pause
  default_mem_limit: 1g
  default_cpus: 1.0
  max_apps_per_user: 3
  # Container-hardening posture, instance-wide (not per-app overridable).
  # `cap_drop: ALL` and `no-new-privileges` are always applied and have no
  # knob. Only these two are configurable:
  container_pids_limit: 512     # anti fork-bomb ceiling
  container_read_only: false    # read-only container rootfs. OFF by default:
                                # the shipped runtime image runs nginx +
                                # supervisord, which write to /var/run,
                                # /var/log and /var/cache/nginx — paths the
                                # tmpfs list in src/data_apps/spec.py does NOT
                                # cover. Turn it on only after booting your
                                # runtime image with it and extending that
                                # list from what actually failed; otherwise
                                # every hosted app crash-loops.


# Authoring Studio (chat-assisted builders at /admin/studio for skills,
# agents, data packages, connections, and corporate memory). On by default.
# Set to false — or export AGNES_STUDIO_ENABLED=0 (the infra/Terraform .env
# override) — to hide the Studio nav entry and redirect /admin/studio* to home.
studio:
  enabled: true


# --- Initial Workspace Template (optional) ---
#
# When configured, Agnes serves the contents of <repo>/workspace/ to analysts
# during `agnes init` (replacing the built-in workspace bootstrap). The
# install-prompt template + connector skills also flow from this seed if
# present — see `docs/seed-repo-contract.md` for the full contract.
#
# Configure via the admin UI: /admin/server-config → "Initial Workspace
# Template". PAT (when the repo is private) lives in
# ${DATA_DIR}/state/.env_overlay, NOT in this file. The block below is
# managed by the API endpoint at /api/admin/initial-workspace — manual
# edits here are honored, but the admin UI is the canonical writer.
#
# initial_workspace:
#   url: https://github.com/keboola/agnes-the-ai-analyst-workspace-seed
#   branch: main
#   token_env: AGNES_INITIAL_WORKSPACE_TOKEN  # optional; PAT name in shell env
#   sync_schedule: "daily 03:30"              # optional; nightly auto-sync cadence.
#                                             # Grammar: src/scheduler.py (daily HH:MM
#                                             # UTC / every Nm / every Nh). Empty = manual
#                                             # sync only. Takes effect on next scheduler
#                                             # restart. Env override:
#                                             # SCHEDULER_INITIAL_WORKSPACE_SCHEDULE
#   last_synced_at: ...                       # written by API after sync
#   last_commit_sha: ...                      # written by API after sync
#   last_error: ...                           # written by API on failure


# --- Connector per-tenant runtime params (optional) ---
#
# Operator-provisioned values that flow into `<workspace>/.claude/agnes/.env`
# via `agnes init`. Seed-resident connector skills read these at install
# time so the user isn't asked for org-specific values that the operator
# already knows.
#
# Values pass through to analysts verbatim. Connector APP credentials —
# e.g. the GWS Desktop-app OAuth client secret, an app identifier rather
# than a user credential — belong here as plain values. Keep per-USER
# secrets out; those are collected on the analyst's machine by the
# connector skills. The legacy `*_ENV` convention (shipping the NAME of a
# shell env var instead of the value) still passes through unchanged, but
# nothing populates such env vars on analyst laptops — prefer values.
#
# Resolution order: `globals` (instance-wide) beats per-connector keys on
# name collision. Empty `connectors:` block → empty .env.agnes (the API
# endpoint /api/connectors/params returns {}), seed skills fall back to
# interactive prompts.
#
# GWS exception: when the shared Google Workspace OAuth client is
# provisioned outside this overlay (server env vars AGNES_GWS_CLIENT_ID /
# AGNES_GWS_CLIENT_SECRET, the admin vault, or `instance.gws.*` above),
# /api/connectors/params merges the equivalent `connector-gws` keys into
# its response automatically — no need to repeat them here. Keys set here
# win over the server-resolved values.
#
# This section is also editable at runtime via /admin/server-config
# (persisted to the DATA_DIR/state/instance.yaml overlay).
#
# connectors:
#   globals:
#     AGNES_INSTANCE_BRAND: Acme Analytics
#   connector-atlassian:
#     ATLASSIAN_BASE_URL: https://acme.atlassian.net
#   connector-gws:
#     AGNES_GWS_CLIENT_ID: 1234-abcd.apps.googleusercontent.com
#     AGNES_GWS_CLIENT_SECRET: GOCSPX-xxxxxxxxxxxxxx
#     # AGNES_GWS_PROJECT_ID is legacy — the bundled connector-gws skill
#     # ignores it (a non-empty project_id in client_secret.json makes the
#     # gws CLI send x-goog-user-project, which requires every analyst to
#     # hold roles/serviceusage.serviceUsageConsumer on the OAuth project).
#     # Only set it if your custom seed template still consumes it.

# --- Signed-URL distribution (optional, off by default) ---
#
# When configured, the worker mirrors distribution parquets to an
# S3-compatible bucket after each sync, and `agnes pull` downloads
# directly from it via short-TTL presigned URLs instead of always
# streaming through the app server — an L-tier bandwidth-offload option.
# With no `object_store.bucket` set, nothing changes: the app-served
# `/api/data/{id}/download` path stays the only download path. Requires
# the `distribution` extra (`pip install "agnes[distribution]"`) for the
# `boto3` S3 client. Full reference: docs/DEPLOYMENT.md → "Signed-URL
# distribution (object store)".
#
# distribution:
#   signed_urls: auto              # auto (on when object_store is configured) | on | off
#                                   # Env override: AGNES_DISTRIBUTION_SIGNED_URLS
#   object_store:
#     bucket: my-agnes-distribution-bucket
#     endpoint_url: https://s3.example.com   # unset for real AWS S3; or GCS's S3-interop
#                                             # endpoint / SeaweedFS / any other S3-compatible
#                                             # managed bucket. Not bundled — bring your own.
#     region: us-east-1
#     prefix: agnes/distribution             # default shown; key layout is {prefix}/<table_id>.parquet
#     # Credentials are NEVER stored here — these two fields name OTHER
#     # environment variables that hold the actual access key / secret key
#     # (same *_env indirection used elsewhere in this file), resolved on
#     # the Agnes server at runtime.
#     access_key_env: AGNES_DISTRIBUTION_OBJECT_STORE_ACCESS_KEY
#     secret_key_env: AGNES_DISTRIBUTION_OBJECT_STORE_SECRET_KEY
#   # Per-field env overrides (win over the yaml values above):
#   # AGNES_DISTRIBUTION_OBJECT_STORE_BUCKET, _ENDPOINT_URL, _REGION, _PREFIX,
#   # _ACCESS_KEY_ENV, _SECRET_KEY_ENV
