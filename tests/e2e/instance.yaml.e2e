# instance.yaml.e2e — config used inside the docker-compose E2E env.
#
# Mirrors instance.yaml.example but with cloud-chat enabled on the
# self-hosted docker provider. The suites that actually spawn sandboxes
# are gated separately by AGNES_E2E_DOCKER=1 on the host (they need the
# apps-runner sidecar up and the agnes-chat-sandbox image built), so the
# default e2e run doesn't require a local sandbox-image build.

config_version: 1

instance:
  name: "Agnes E2E"
  subtitle: "End-to-end test instance"
  copyright: "E2E"
  brand: "Agnes"

data_source:
  type: "csv"

chat:
  enabled: true
  provider: docker
  # Built from the repo root (one-time, before the gated suites):
  #   docker build -t agnes-chat-sandbox:latest app/initial_workspace_default/docker-sandbox
  docker_image: "agnes-chat-sandbox:latest"
  # Must match the fixed network name docker-compose.e2e.yml gives its
  # default network — sandbox containers join it so the rails URL
  # (AGNES_INTERNAL_URL=http://agnes:8000) resolves from inside a sandbox.
  docker_network: "agnes-e2e"
  # pause (the default) rather than the removed e2b_kill_on_ws_disconnect:
  # that kill-on-disconnect behavior existed to stop E2B billable minutes,
  # a paused local container is free — and pause is what lets
  # test_adversarial.py::test_resume_uses_fresh_ticket exercise resume.
  on_detach: pause
  concurrency_per_user: 3
  idle_ttl_seconds: 1800
  per_tool_call_seconds: 90
  per_session_bq_scan_bytes: 21474836480
  daily_anthropic_spend_usd: 20.0
  max_session_seconds: 14400
  max_session_tokens: 200000
  rate_messages_per_hour: 100
  tool_calls_per_turn_budget: 50
  marketplace_sha_debounce_seconds: 300
