{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.keboola/agnes",
  "title": "Agnes",
  "description": "Governed access to your company's data and memory: catalog, schema, SQL and skills.",
  "version": "0.93.0",
  "websiteUrl": "https://github.com/keboola/agnes-the-ai-analyst/blob/main/docs/README.md",
  "repository": {
    "url": "https://github.com/keboola/agnes-the-ai-analyst",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{instance_host}/api/mcp/http",
      "variables": {
        "instance_host": {
          "description": "Hostname of your Agnes instance, e.g. agnes.example.com",
          "isRequired": true,
          "format": "string",
          "placeholder": "agnes.example.com"
        }
      }
    }
  ]
}
