{$DOMAIN:localhost} {
	# Cert provisioning. Driven by env var CADDY_TLS:
	#   - unset (default) → cert-file mode for corporate PKI (rotated by
	#     scripts/ops/agnes-tls-rotate.sh into /data/state/certs/).
	#   - "tls <email>"   → Let's Encrypt auto-issue, e.g. "tls ops@example.com"
	#                       (used by public-internet deployments).
	#   - "tls internal"  → Caddy-managed self-signed cert (lab/dev only,
	#                       browser warning on every visit).
	#
	# The {$VAR:default} substitution lets one Caddyfile serve all three
	# regimes without per-deployment forks. Caddyfile parses the substituted
	# string as a directive, so the value MUST start with `tls `.
	{$CADDY_TLS:tls /certs/fullchain.pem /certs/privkey.pem} {
		# Modern TLS only. Caddy default already excludes 1.0/1.1 in
		# most builds, but pin explicitly so a future Caddy default
		# change can't silently weaken our posture.
		protocols tls1.2 tls1.3
	}

	# Security headers
	header {
		# HSTS: tell compliant browsers to refuse plain-HTTP for this host
		# for a year. Skipping `preload` so we keep an escape hatch (preload
		# submission is hard-bound and blocks rollback). Skipping
		# `includeSubDomains` because we don't control subdomains.
		Strict-Transport-Security "max-age=31536000"
		# Prevent clickjacking — dashboard is not embedded in iframes
		X-Frame-Options "DENY"
		# Prevent MIME-type sniffing — browser must honor declared Content-Type
		X-Content-Type-Options "nosniff"
		# Limit referrer leakage to origin on same-site navigations only
		Referrer-Policy "strict-origin-when-cross-origin"
		# Strip Server header to avoid fingerprinting the reverse proxy
		-Server
	}

	# Direct file_server for parquet downloads — bypasses uvicorn so a
	# multi-GB pull from one analyst can't starve the app workers and
	# block UI / health / API for everyone else. forward_auth calls the
	# app's lightweight ``/api/data/{id}/check-access`` (RBAC only,
	# ~1 ms) on every request; on 2xx Caddy serves the file directly
	# via sendfile/zero-copy from the data volume mounted read-only.
	#
	# Path layout matches `app/api/data.py`'s extract.duckdb v2 search:
	#   /data/extracts/<source_type>/data/<table_id>.parquet
	# try_files probes known source subdirs in order; first hit wins.
	# If a deployment adds a new connector and lands parquets at a fresh
	# subdir, extend the try_files list. Anything that misses falls
	# through to the app reverse_proxy below — so an unmapped source
	# degrades to "downloads work, just through uvicorn" — never 404.
	#
	# `?part=` is excluded deliberately. `path_regexp` matches the PATH only,
	# so without this a per-part fetch claims the whole-table rule. Every
	# try_files candidate below is the single-file `<table_id>.parquet`, while
	# a partitioned table is a DIRECTORY (`<table_id>/month=YYYY-MM/…`) — so
	# this branch cannot answer a part request with anything but the wrong
	# bytes: the entire table, served as one month. The rule is simply that a
	# path-only matcher must not claim a route whose meaning depends on the
	# query string; that holds regardless of what happens to be on disk.
	#
	# Parts go to the app instead. No authz is lost by skipping forward_auth:
	# `download_table` re-checks `can_access_table`, enforces the distribution
	# gate, and writes the `data.download` audit row with the `part` recorded.
	@download {
		path_regexp tid ^/api/data/([^/]+)/download$
		not query part=*
	}
	handle @download {
		forward_auth app:8000 {
			uri /api/data/{re.tid.1}/check-access
			# NO copy_headers here. forward_auth already forwards the
			# ORIGINAL request (incl. Authorization / Cookie) to the
			# check-access upstream, so the bearer PAT / session cookie
			# authenticate the RBAC probe. copy_headers does the opposite
			# — it copies headers FROM check-access's response back onto
			# the request; since /check-access returns 204 with no such
			# headers, on Caddy >= 2.11.2 (GHSA-7r4p-vjf4-gxv4) that
			# DELETES the client's Authorization/Cookie from the request,
			# so any download that falls through to the app reverse_proxy
			# below (e.g. a partitioned-table `?part=` fetch, or any table
			# not served by the file_server static path) hits the app with
			# no credential and 401s. Leave it off.
		}
		# Caddy's own /data is occupied by the caddy_data volume, so the
		# agnes data dir is mounted at /srv (read-only) instead — see the
		# `data:/srv:ro` line in docker-compose.yml's caddy service. The
		# root + try_files combo therefore probes /srv/extracts/...
		#
		# Devin Review caught: `try_files A B C` rewrites the URI to its
		# LAST entry when no file matches (per Caddy docs). Without an
		# explicit "rewrite back to original URI" fallback, a parquet
		# missing from all three known paths would get rewritten to the
		# last static candidate (`/jira/data/<id>.parquet`), and the
		# reverse_proxy below would forward THAT rewritten URI to
		# app:8000 → app has no such route → 404. To make the documented
		# "missed → falls through to app handler" promise hold, append
		# the original `/api/data/<id>/download` path as the final
		# try_files entry: when no file matches, the URI is rewritten
		# back to the analyst-facing path and the app's `download_table`
		# handler picks it up via the reverse_proxy fallback below.
		root * /srv/extracts
		try_files /bigquery/data/{re.tid.1}.parquet /keboola/data/{re.tid.1}.parquet /jira/data/{re.tid.1}.parquet /api/data/{re.tid.1}/download
		@found file
		handle @found {
			header Content-Disposition "attachment; filename=\"{re.tid.1}.parquet\""
			file_server
		}
		# Fallback: parquet not at any known static path → defer to app
		# (handles legacy src_data/parquet layout + future connectors).
		reverse_proxy app:8000 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			# Security audit F9: overwrite X-Forwarded-For with the real peer.
			header_up X-Forwarded-For {remote_host}
			# Immediate flush — see the main reverse_proxy block below for why
			# SSE (chat LLM proxy, MCP) needs this; keep both app proxies aligned.
			flush_interval -1
			lb_try_duration 5s
			lb_try_interval 1s
		}
	}

	# `/metrics` is an internal-scrape-only surface (docs/observability.md:
	# "Operators must not expose this endpoint publicly"; a scraper polls the
	# app port from inside the deployment boundary, never through this proxy).
	# Without this deny the catch-all reverse_proxy below would forward it to
	# the app, exposing the unauthenticated observability payload (queue
	# depth, worker-lane occupancy, replica hostname:pid, per-route latency
	# histograms, the full route inventory) to the open internet. `/healthz` +
	# `/readyz` stay reachable — they leak only status and double as
	# LB/uptime probes. Mirrors deploy/caddy/Caddyfile.mtier, which has
	# carried the same rule since it shipped.
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy app:8000 {
		# App's uvicorn runs with --proxy-headers, so stamping these
		# ourselves makes OAuth callback URLs and Set-Cookie Secure
		# flags resolve to https consistently. X-Forwarded-Host is
		# also Caddy's default, but pinning it explicitly insures
		# against future default changes.
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		# Security audit F9: overwrite (not append) X-Forwarded-For with the
		# real peer IP so a client-supplied XFF header can't rotate per-IP
		# rate-limit buckets on the auth endpoints. The app additionally
		# trusts only AGNES_TRUSTED_PROXY_HOPS rightmost hops.
		header_up X-Forwarded-For {remote_host}
		# Flush every write straight to the client instead of buffering the
		# response. The cloud-chat LLM proxy (/api/broker/anthropic) and the
		# MCP endpoint (/api/mcp) stream Server-Sent Events; Caddy only
		# auto-flushes when the Content-Type is EXACTLY "text/event-stream",
		# but Starlette appends "; charset=utf-8", so auto-detection misses it
		# and the whole completion is buffered — the model's token deltas then
		# arrive in one end-of-turn burst (verified live: mac→Caddy→app→Anthropic
		# delivered every delta at a single timestamp; the same request straight
		# to the app streamed). -1 forces immediate flush regardless of
		# Content-Type. Harmless for JSON/HTML (single-write) and parquet
		# (already chunked); required for SSE.
		flush_interval -1
		# Absorb brief connection blips (e.g. worker restart) without
		# surfacing an error. Longer outages (full container restart on
		# auto-upgrade, ~30–60 s) fall through to handle_errors below.
		lb_try_duration 5s
		lb_try_interval 1s
	}

	# Served when the app is restarting (502) or temporarily overloaded
	# (503). The page auto-refreshes every 12 s so users need not act.
	handle_errors 502 503 {
		root * /caddy-static
		rewrite * /maintenance.html
		file_server
	}
}

# Legacy-domain handler, for the window of a domain migration. Set
# DOMAIN_ALIAS to a hostname you are moving AWAY from: Caddy then serves that
# name too, with its own cert, instead of failing the TLS handshake the moment
# DOMAIN changes — which is what would otherwise break old bookmarks, `agnes`
# CLI configs pointing at `server`, and MCP connector URLs, with a certificate
# error rather than a path onto the new address. Drop the variable once the
# old DNS record is retired.
#
# Two audiences, two answers. A person arriving in a browser gets a short
# notice page telling them the address changed and what still points at the
# old one — a silent redirect moves them along but never tells them to update
# the bookmark, so the old name stays in circulation right up until it dies.
# Everything else — the CLI, MCP clients, `agnes pull` — gets the plain 308,
# because an HTML notice served to a machine client is just a confusing parse
# error. The split is on `Accept: text/html`, which browsers send on
# navigation and API clients do not.
#
# Why a second site block and not `DOMAIN="new.example.com, old.example.com"`:
# Caddyfile env substitution is token-level, so a comma list inside ONE
# variable is parsed as a single malformed address, not two site addresses.
#
# The default is deliberately `127.0.0.1:8081` — a port docker-compose never
# publishes, so an unconfigured deployment gets an inert block. Two properties
# of that default are load-bearing:
#   - NON-PUBLIC. Any resolvable name would make every Agnes deployment
#     attempt an ACME issuance for it on each start.
#   - a different HOSTNAME from the primary site's own `localhost` default,
#     not merely a different port. Sharing a hostname across two site blocks
#     with different certificate settings is a hard config error — "hostname
#     appears in more than one automation policy, making certificate
#     management ambiguous" — and Caddy then refuses to start at all, which
#     on a DOMAIN-less lab deployment means no server rather than no alias.
{$DOMAIN_ALIAS:127.0.0.1:8081} {
	# NO `tls` directive here, deliberately — do not "fix" this by mirroring
	# the primary site's {$CADDY_TLS}. An explicit `tls <email>` pins an ACME
	# issuer for the site, which overrides Caddy's per-name issuer choice: the
	# inert localhost default then loops forever on
	#   [localhost] Obtain: subject 'localhost' does not qualify for a public
	#   certificate ... retrying_in 60
	# on EVERY deployment that never set DOMAIN_ALIAS (verified live against
	# caddy:2-alpine; the same run without the directive logs `certificate
	# obtained successfully, issuer: local`). Left implicit, automatic HTTPS
	# picks the right issuer per name — internal for the localhost default,
	# public ACME for a real alias hostname. The alias's ACME account carries
	# no contact email (CADDY_TLS's email belongs to the primary site's
	# policy); that costs only expiry notices on a cert that exists for the
	# length of a migration. A corporate-PKI deployment (CADDY_TLS unset,
	# certs on disk) that sets DOMAIN_ALIAS should instead put both names on
	# one SAN cert — this block would try public ACME for the legacy name.

	# Browser navigation → the notice page. HEAD is included so a probe sees
	# the same status as the GET it precedes.
	@browser {
		method GET HEAD
		header Accept *text/html*
	}
	handle @browser {
		header Content-Type "text/html; charset=utf-8"
		# Deliberately no <style> block: Caddy substitutes placeholders in a
		# `respond` body, and a CSS rule's braces read as placeholder syntax.
		# Every style here is therefore an inline attribute.
		#
		# {$DOMAIN} is resolved once at config-parse time and is the ONLY
		# placeholder here. {uri} is deliberately absent: Go leaves the query
		# string raw in RequestURI(), so reflecting it into an href= or
		# content= attribute lets `?x="><…>` inject markup into a response
		# served by the legacy hostname — an origin browsers still hold
		# cookies for during the migration. The deep link is not worth a
		# reflected-XSS vector on that origin; the non-browser branch below
		# still carries {uri} in a Location header, where it cannot become
		# markup (Devin Review on #1182).
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width,initial-scale=1">
			<title>This address has moved</title>
			<meta http-equiv="refresh" content="15;url=https://{$DOMAIN:localhost}/">
			</head>
			<body style="margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f6f7f9;color:#1b1f24;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif">
			<main style="max-width:32rem;padding:2rem">
			<p style="margin:0 0 .5rem;font-size:.75rem;letter-spacing:.09em;text-transform:uppercase;color:#6b7280">Address changed</p>
			<h1 style="margin:0 0 1rem;font-size:1.5rem;font-weight:600;line-height:1.3">This instance has moved to a new address</h1>
			<p style="margin:0 0 1.5rem;line-height:1.6;color:#374151">You reached it on its old hostname. That name still answers for now, but it stops working once the old DNS record is retired.</p>
			<p style="margin:0 0 1.5rem"><a href="https://{$DOMAIN:localhost}/" style="display:inline-block;padding:.7rem 1.15rem;border-radius:.5rem;background:#2563eb;color:#fff;font-weight:600;text-decoration:none">Continue to {$DOMAIN:localhost}</a></p>
			<p style="margin:0;line-height:1.6;font-size:.9rem;color:#6b7280">Please update anything still pointing here: browser bookmarks, the <code>server</code> entry in your <code>agnes</code> CLI config, and any connector configured with this hostname. Taking you there automatically in 15 seconds.</p>
			</main>
			</body>
			</html>
			HTML 200
	}

	# Everything else — API clients, the CLI, MCP. 308, not 301: both are
	# permanent and equally cacheable, but clients re-issue a 301 on
	# POST/PUT/PATCH as a GET with the body dropped, and this branch is
	# precisely the one carrying `agnes push` and MCP JSON-RPC. A 301 here
	# would break what the alias exists to carry. 308 preserves method and
	# body; {uri} carries path + query through unchanged
	# (Devin Review on #1182).
	#
	# What no redirect can fix: the `agnes` CLI does not follow redirects at all
	# (`cli/client.py` omits `follow_redirects`; the parquet path refuses them),
	# and a client that did would lose Authorization on a cross-host hop. So for
	# the CLI this turns a TLS failure into a legible HTTP error rather than
	# working transparently. Browser-grade safety net; API callers still need
	# repointing — see docs/DEPLOYMENT.md.
	handle {
		redir https://{$DOMAIN:localhost}{uri} 308
	}
}
