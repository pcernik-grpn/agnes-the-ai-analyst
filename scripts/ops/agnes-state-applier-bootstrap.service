[Unit]
Description=Bootstrap state for agnes-state-applier — create user, prep /data/state
Before=agnes-state-applier.service agnes-state-applier.timer
After=local-fs.target

# Runs as root (no User=) so we can actually create the agnes-applier
# user. The companion agnes-state-applier.service is ordered After=
# this one (via Before= here) so by the time systemd loads the User=
# directive there, the user definitely exists.
#
# Phase 8.1 follow-up #2: an earlier attempt put the user-creation in
# ExecStartPre=+ of the main unit. systemd validates User= at unit
# LOAD time, not at ExecStartPre run time, so the unit refused to
# even start with "Failed to determine user credentials" before any
# ExecStartPre had a chance to fire. Splitting into a dedicated
# root-running bootstrap unit is the canonical systemd pattern for
# self-bootstrapping user accounts.

[Service]
Type=oneshot
RemainAfterExit=yes
# The uid is PINNED to 999 — must equal the app container's uid (Dockerfile
# `useradd --system --uid 999 ... agnes`, `USER agnes`). instance.yaml is
# written 0600 and ends up owned by agnes-applier (the chown two lines
# below, and every rewrite the applier itself does), so the app container
# can read its own config only while the two uids agree. This unit is the
# ONLY place that creates agnes-applier on infras that don't run the OSS
# customer-instance module's own startup-script (which pins the same uid,
# see infra/modules/customer-instance/startup-script.sh.tpl) — without the
# pin here, `useradd --system` on such an infra allocates whatever uid is
# free, silently breaking the assumption (#1217).
#
# Falls back to an unpinned useradd if 999 is already taken by a different
# account, same as the startup-script: a hard failure here would brick
# provisioning to protect a file (instance.yaml) nobody could read anyway.
# The readback ExecStart= below reports the mismatch loudly instead. The
# group is ensured separately (`--gid`, not `--user-group`) so an orphaned
# agnes-applier group — e.g. after a userdel that kept it — cannot fail
# both useradd attempts and mark this unit failed.
ExecStart=/bin/bash -c 'id -u agnes-applier >/dev/null 2>&1 || { getent group agnes-applier >/dev/null 2>&1 || groupadd --system agnes-applier; useradd --system --no-create-home --shell /usr/sbin/nologin --uid 999 --gid agnes-applier agnes-applier 2>/dev/null || useradd --system --no-create-home --shell /usr/sbin/nologin --gid agnes-applier agnes-applier; }'
# Loud, non-fatal readback — covers both non-happy paths from #1217: the pin
# above falling through to an allocated uid (999 taken at THIS boot), and an
# agnes-applier that already existed from before this unit pinned anything
# (an in-place upgrade). Logged via `logger` (journald), not just stdout,
# so it survives `RemainAfterExit` collapsing the unit's own log window.
# Deliberately does not fail the unit: instance.yaml is simply kept
# app-readable at a looser mode (0640 with the app's gid where the host
# lets the applier grant it, 0644 otherwise) until an operator frees uid
# 999 or realigns agnes-applier — see docs/postgres-cutover-runbook.md for
# the remediation commands. Warn-only is only defensible because that claim
# is enforced on BOTH writers of the file: the startup-script gates its
# `chmod 600` on the same readback, and the applier's write_instance_yaml
# computes the mode from the uid the file will come to rest on — never an
# owner-only mode, preserved or fresh, under a uid the app is not
# (scripts/ops/agnes-state-applier.sh::_instance_yaml_target_mode). Until
# the latter existed, this comment was false — the applier tightened to 0600
# regardless and the app then refused to start.
ExecStart=/bin/bash -c 'APPLIER_UID=$$(id -u agnes-applier 2>/dev/null || echo ""); if [ "$$APPLIER_UID" != "999" ]; then logger -t agnes-state-applier-bootstrap -p user.warning "agnes-applier is uid $$APPLIER_UID, not 999 -- the state applier keeps /data/state/instance.yaml readable by the app container (mode 0640 with group 999 where it can grant that, 0644 otherwise) instead of the owner-only 0600 an aligned host gets. Free uid 999 (check what holds it: getent passwd 999) or realign agnes-applier onto it, then re-run this unit; see docs/postgres-cutover-runbook.md."; fi'
ExecStart=/usr/sbin/usermod -aG docker agnes-applier
ExecStart=/bin/mkdir -p /data/state /data/postgres
ExecStart=/bin/chown -R agnes-applier:agnes-applier /data/state
# -R matters here, not just on /data/state above: this unit reruns on every
# boot (RemainAfterExit doesn't skip a fresh systemd start after a VM
# recreate), and /data/postgres is on the persistent data disk — it survives
# a boot-disk-only VM recreate with its *existing* PGDATA contents already
# on disk. A non-recursive chown fixed only the top-level directory, leaving
# nested files (verified live: global/pg_filenode.map) owned by whatever the
# previous instance's postgres container mapped uid 70 to, so a fresh
# container on the recreated VM hit "Permission denied" reading its own data
# directory. Observed live on a customer VM after a delete+insert.
ExecStart=/bin/bash -c 'chown -R 70:70 /data/postgres && chmod 700 /data/postgres'
# Make /opt/agnes/.env readable by the applier. The applier reads only
# AGNES_TAG from it (via its _env_get helper — it does NOT shell-source
# the file); docker compose's --env-file path also reads it directly.
# We chown to ``agnes-applier:agnes-applier`` (owner = applier user,
# mode 0600) rather than just chgrp + 0640: docker compose's Go file
# loader opens the file with flags that fail for group-only access
# on some libc versions ("permission denied" on the open() syscall
# even when /etc/group lists the user in the file's group). Setting
# the owner makes it unambiguous regardless of how the caller opens
# the file. Bootstrap unit runs as root, has the privileges to flip
# ownership; the file still contains secrets but is owner-only readable
# (mode 0600), so the security posture is unchanged — only the
# identity of the owner moved from root → agnes-applier.
ExecStart=/bin/bash -c 'if [ -f /opt/agnes/.env ]; then chown agnes-applier:agnes-applier /opt/agnes/.env && chmod 0600 /opt/agnes/.env; fi'

[Install]
WantedBy=multi-user.target
